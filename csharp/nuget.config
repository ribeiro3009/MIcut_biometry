<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Limpa todos os package sources herdados (user-level, machine-level)
    e usa só o nuget.org público. Necessário em máquinas com feeds
    corporativos privados configurados em NuGet.Config de nível de
    usuário/máquina que retornam 401 sem credenciais.

    Os 4 NuGets usados pelo projeto (OpenCvSharp4, OpenCvSharp4.runtime.win,
    SourceAFIS, System.Formats.Cbor) e os de teste (xUnit, etc) estão todos
    em nuget.org — nenhum precisa de feed privado.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
